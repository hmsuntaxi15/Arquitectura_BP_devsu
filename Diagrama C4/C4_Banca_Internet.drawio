=none;strokeColor=#888780;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fontStyle=1;fontColor=#5F5E5A;" value="Primer ingreso y vinculación del dispositivo" vertex="1"><mxGeometry x="25" y="790" width="2060" height="280" as="geometry" /></mxCell><mxCell id="f14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fontStyle=1;fontColor=#5F5E5A;" value="Ingresos siguientes" vertex="1"><mxGeometry x="25" y="1090" width="2060" height="320" as="geometry" /></mxCell><mxCell id="s1" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="1. Acepta el tratamiento de sus datos biométricos"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="120" y="175" /><mxPoint as="targetPoint" x="340" y="175" /></mxGeometry></mxCell><mxCell id="s2" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="2. Inicia el alta con el consentimiento (vía Front Door y API Management)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="340" y="220" /><mxPoint as="targetPoint" x="560" y="220" /></mxGeometry></mxCell><mxCell id="s3" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="3. Prueba de vida (SDK)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="340" y="265" /><mxPoint as="targetPoint" x="1000" y="265" /></mxGeometry></mxCell><mxCell id="s4" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="4. Resultado firmado con el cuadro certificado (callback HMAC)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1000" y="310" /><mxPoint as="targetPoint" x="560" y="310" /></mxGeometry></mxCell><mxCell id="s5" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="5. Compara ese mismo cuadro con la cédula"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="560" y="355" /><mxPoint as="targetPoint" x="780" y="355" /></mxGeometry></mxCell><mxCell id="s6" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="6. Coincide"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="780" y="400" /><mxPoint as="targetPoint" x="560" y="400" /></mxGeometry></mxCell><mxCell id="s7" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="7. Revisa listas restrictivas y PEP"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="560" y="445" /><mxPoint as="targetPoint" x="1220" y="445" /></mxGeometry></mxCell><mxCell id="s8" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="8. Sin coincidencias"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1220" y="490" /><mxPoint as="targetPoint" x="560" y="490" /></mxGeometry></mxCell><mxCell id="s9" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="9. Crea el cliente y la cuenta (Idempotency-Key = trámite)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="560" y="535" /><mxPoint as="targetPoint" x="1440" y="535" /></mxGeometry></mxCell><mxCell id="s10" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="10. Cliente creado"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1440" y="580" /><mxPoint as="targetPoint" x="560" y="580" /></mxGeometry></mxCell><mxCell id="s11" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="11. Crea el usuario: contraseña (primer factor) y MFA"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="560" y="625" /><mxPoint as="targetPoint" x="1660" y="625" /></mxGeometry></mxCell><mxCell id="s12" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="12. Usuario creado"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1660" y="670" /><mxPoint as="targetPoint" x="560" y="670" /></mxGeometry></mxCell><mxCell id="s13" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="13. Alta completa"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="560" y="715" /><mxPoint as="targetPoint" x="340" y="715" /></mxGeometry></mxCell><mxCell id="s14" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="14. Primer login: Code + PKCE (navegador del sistema)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="340" y="845" /><mxPoint as="targetPoint" x="1660" y="845" /></mxGeometry></mxCell><mxCell id="s15" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="15. Access token y refresh token"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1660" y="890" /><mxPoint as="targetPoint" x="340" y="890" /></mxGeometry></mxCell><mxCell id="s16" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="16. Crea la llave del dispositivo (protegida por biometría)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="340" y="935" /><mxPoint as="targetPoint" x="1880" y="935" /></mxGeometry></mxCell><mxCell id="s17" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="17. Registra la llave pública con el token"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="340" y="980" /><mxPoint as="targetPoint" x="2100" y="980" /></mxGeometry></mxCell><mxCell id="s18" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="18. Dispositivo vinculado"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="2100" y="1025" /><mxPoint as="targetPoint" x="340" y="1025" /></mxGeometry></mxCell><mxCell id="s19" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="19. Huella o rostro"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="120" y="1150" /><mxPoint as="targetPoint" x="340" y="1150" /></mxGeometry></mxCell><mxCell id="s20" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="20. Solicita el ingreso"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="340" y="1195" /><mxPoint as="targetPoint" x="2100" y="1195" /></mxGeometry></mxCell><mxCell id="s21" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="21. Desafío (nonce)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="2100" y="1240" /><mxPoint as="targetPoint" x="340" y="1240" /></mxGeometry></mxCell><mxCell id="s22" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="22. Firma el desafío con la llave del dispositivo"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="340" y="1285" /><mxPoint as="targetPoint" x="1880" y="1285" /></mxGeometry></mxCell><mxCell id="s23" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="23. Desafío firmado + token (HTTPS, JWT)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="340" y="1330" /><mxPoint as="targetPoint" x="2100" y="1330" /></mxGeometry></mxCell><mxCell id="s24" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="24. Sesión ligada al dispositivo: cada solicitud lleva una prueba de posesión firmada (al estilo de DPoP)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="2100" y="1375" /><mxPoint as="targetPoint" x="340" y="1375" /></mxGeometry></mxCell></root>
