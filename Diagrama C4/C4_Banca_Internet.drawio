" width="160" height="56" as="geometry" /></mxCell><mxCell id="l6" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#B4B2A9;dashed=1;endArrow=none;" value=""><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="1380" y="116" /><mxPoint as="targetPoint" x="1380" y="1130" /></mxGeometry></mxCell><mxCell id="p7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Notificaciones y Auditoría&lt;/b&gt;" vertex="1"><mxGeometry x="1510" y="60" width="160" height="56" as="geometry" /></mxCell><mxCell id="l7" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#B4B2A9;dashed=1;endArrow=none;" value=""><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="1590" y="116" /><mxPoint as="targetPoint" x="1590" y="1130" /></mxGeometry></mxCell><mxCell id="f1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fontStyle=1;fontColor=#5F5E5A;" value="Solicitud" vertex="1"><mxGeometry x="25" y="130" width="1460" height="330" as="geometry" /></mxCell><mxCell id="f2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fontStyle=1;fontColor=#5F5E5A;" value="loop Conciliación (cada 30 s, hasta 10 minutos)" vertex="1"><mxGeometry x="25" y="480" width="1450" height="360" as="geometry" /></mxCell><mxCell id="f3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fontStyle=1;fontColor=#5F5E5A;" value="alt [el Core ya registró el débito]" vertex="1"><mxGeometry x="640" y="560" width="820" height="220.0" as="geometry" /></mxCell><mxCell id="f4" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;fontColor=#5F5E5A;spacingLeft=6;" value="[else: el Core no lo registró]" vertex="1"><mxGeometry x="640" y="670" width="820" height="18" as="geometry" /></mxCell><mxCell id="f5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fontStyle=1;fontColor=#5F5E5A;" value="opt [pasan 10 minutos sin resultado]" vertex="1"><mxGeometry x="25" y="860" width="1450" height="130" as="geometry" /></mxCell><mxCell id="m1" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="1. Confirma con biometría y MFA"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="120" y="170" /><mxPoint as="targetPoint" x="330" y="170" /></mxGeometry></mxCell><mxCell id="m2" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="2. POST con Idempotency-Key"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="330" y="206" /><mxPoint as="targetPoint" x="540" y="206" /></mxGeometry></mxCell><mxCell id="m3" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="3. Reenvía con JWT"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="540" y="242" /><mxPoint as="targetPoint" x="750" y="242" /></mxGeometry></mxCell><mxCell id="m4" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="4. POST débito (misma Idempotency-Key)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="750" y="280" /><mxPoint as="targetPoint" x="960" y="280" /></mxGeometry></mxCell><mxCell id="n1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#5F5E5A;" value="Sin respuesta: vence el timeout (5 s)" vertex="1"><mxGeometry x="970" y="292" width="260" height="24" as="geometry" /></mxCell><mxCell id="m5" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="5. Saga: Resultado incierto (no se reintenta con otra clave)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /><Array as="points"><mxPoint x="805" y="330" /><mxPoint x="805" y="354" /></Array><mxPoint as="sourcePoint" x="750" y="330" /><mxPoint as="targetPoint" x="750" y="354" /></mxGeometry></mxCell><mxCell id="m6" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="6. 202 En verificación + referencia"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="750" y="392" /><mxPoint as="targetPoint" x="540" y="392" /></mxGeometry></mxCell><mxCell id="m7" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="7. Respuesta"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="540" y="416" /><mxPoint as="targetPoint" x="330" y="416" /></mxGeometry></mxCell><mxCell id="m8" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="8. Transferencia en verificación"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="330" y="440" /><mxPoint as="targetPoint" x="120" y="440" /></mxGeometry></mxCell><mxCell id="m9" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="9. GET estado por Idempotency-Key"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1380" y="520" /><mxPoint as="targetPoint" x="960" y="520" /></mxGeometry></mxCell><mxCell id="m10" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;dashed=1;endArrow=open;endFill=1;" value="10. Estado de la operación"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="960" y="546" /><mxPoint as="targetPoint" x="1380" y="546" /></mxGeometry></mxCell><mxCell id="m11" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="11a. Débito registrado: Saga continúa"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1380" y="598" /><mxPoint as="targetPoint" x="750" y="598" /></mxGeometry></mxCell><mxCell id="m12" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#185FA5;dashed=1;endArrow=open;endFill=1;" value="12a. Evento Debitada (Outbox); la Saga continúa con el envío al SPI (Figura 13)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="750" y="640" /><mxPoint as="targetPoint" x="1170" y="640" /></mxGeometry></mxCell><mxCell id="m13" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="11b. El Core no lo registró: se cancela la operación y se libera el cupo"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1380" y="706" /><mxPoint as="targetPoint" x="750" y="706" /></mxGeometry></mxCell><mxCell id="m15" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#185FA5;dashed=1;endArrow=open;endFill=1;" value="13. Evento Cancelada (Outbox)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="750" y="770" /><mxPoint as="targetPoint" x="1170" y="770" /></mxGeometry></mxCell><mxCell id="m16" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#185FA5;dashed=1;endArrow=open;endFill=1;" value="14. Aviso al cliente y auditoría"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1170" y="800" /><mxPoint as="targetPoint" x="1590" y="800" /></mxGeometry></mxCell><mxCell id="m17" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#185FA5;dashed=1;endArrow=open;endFill=1;" value="15. Alerta a Operaciones (revisión manual)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1380" y="905" /><mxPoint as="targetPoint" x="1590" y="905" /></mxGeometry></mxCell><mxCell id="m18" edge="1" parent="1" style="html=1;rounded=0;fontSize=10;strokeColor=#5F5E5A;endArrow=block;endFill=1;" value="16. Saga: En revisión manual (con registro y auditoría)"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-10" /><mxPoint as="sourcePoint" x="1380" y="950" /><mxPoint as="targetPoint" x="750" y="950" /></mxGeometry></mxCell><mxCell id="nt" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F5E5A;" value="&lt;b&gt;Regla:&lt;/b&gt; un timeout no se trata como falla. La operación queda en estado incierto, el cliente recibe una respuesta de verificación y el Conciliador consulta el Core con la misma clave de idempotencia hasta conocer el resultado. Nunca se envía un segundo débito con otra clave. Si el Core confirma que no registró la operación, se cancela y se avisa al cliente; no se reintenta, porque su intención pudo haber cambiado." vertex="1"><mxGeometry x="40" y="1020" width="1600" height="60" as="geometry" /></mxCell><mxCell id="f4ln" edge="1" parent="1" style="html=1;rounded=0;strokeColor=#888780;dashed=1;endArrow=none;" value=""><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="640.0" y="670.0" /><mxPoint as="targetPoint" x="1460.0" y="670.0" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Secuencia Onboarding y login" id="pg14">
