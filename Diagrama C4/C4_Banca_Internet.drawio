        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Normalizador&lt;/b&gt;&lt;br&gt;Esquema único y enmascarado de datos" vertex="1">
