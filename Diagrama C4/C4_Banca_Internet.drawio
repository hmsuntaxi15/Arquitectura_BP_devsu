        <mxCell id="t" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="C3 - Componentes: Servicio de Onboarding (reconocimiento facial y alta de identidad)" vertex="1">
          <mxGeometry height="30" width="1700" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;" value="&lt;b&gt;App móvil&lt;/b&gt;&lt;br&gt;SDK de captura facial" vertex="1">
          <mxGeometry height="80" width="190" x="40" y="210" as="geometry" />
        </mxCell>
        <mxCell id="B" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F6E56;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#0F6E56;" value="Servicio de Onboarding - .NET" vertex="1">
          <mxGeometry height="300" width="1420" x="300" y="160" as="geometry" />
        </mxCell>
        <mxCell id="ctl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Controlador y sesión&lt;/b&gt;&lt;br&gt;Máquina de estados del alta, con el consentimiento biométrico" vertex="1">
          <mxGeometry height="80" width="200" x="320" y="210" as="geometry" />
        </mxCell>
        <mxCell id="orq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Orquestador de onboarding (Saga)&lt;/b&gt;&lt;br&gt;1) consentimiento y datos, 2) prueba de vida, 3) rostro de ese mismo cuadro contra el Registro Civil, 4) debida diligencia (listas, PEP), 5) crear cliente en el Core, 6) crear identidad, 7) enrolar dispositivo. Compensa si un paso falla" vertex="1">
          <mxGeometry height="80" width="1130" x="560" y="210" as="geometry" />
        </mxCell>
        <mxCell id="rep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Repositorio de estado&lt;/b&gt;&lt;br&gt;Intentos, resultado y evidencias mínimas" vertex="1">
          <mxGeometry height="80" width="190" x="320" y="330" as="geometry" />
        </mxCell>
        <mxCell id="crc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Cliente Registro Civil (ACL)&lt;/b&gt;&lt;br&gt;Comparación del rostro, TLS, firma" vertex="1">
          <mxGeometry height="80" width="190" x="555" y="330" as="geometry" />
        </mxCell>
        <mxCell id="clv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Cliente liveness&lt;/b&gt;&lt;br&gt;Prueba de vida, callbacks firmados (HMAC)" vertex="1">
          <mxGeometry height="80" width="190" x="790" y="330" as="geometry" />
        </mxCell>
        <mxCell id="ckyc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Cliente cumplimiento (KYC)&lt;/b&gt;&lt;br&gt;Listas restrictivas, PEP y sanciones, TLS" vertex="1"><mxGeometry x="1025" y="330" width="190" height="80" as="geometry" /></mxCell><mxCell id="ccor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Cliente Core (ACL)&lt;/b&gt;&lt;br&gt;Crea cliente y cuenta, idempotencia, mTLS" vertex="1"><mxGeometry x="1260" y="330" width="190" height="80" as="geometry" /></mxCell><mxCell id="cid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Cliente identidad&lt;/b&gt;&lt;br&gt;Crea usuario, credenciales y MFA" vertex="1">
          <mxGeometry height="80" width="190" x="1495" y="330" as="geometry" />
        </mxCell>
        <mxCell id="xbd" parent="1" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;" value="&lt;b&gt;BD Onboarding&lt;/b&gt;&lt;br&gt;Azure SQL" vertex="1">
          <mxGeometry height="90" width="210" x="310" y="520" as="geometry" />
        </mxCell>
        <mxCell id="xrc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;" value="&lt;b&gt;Registro Civil&lt;/b&gt;&lt;br&gt;Base de rostros" vertex="1">
          <mxGeometry height="90" width="210" x="545" y="520" as="geometry" />
        </mxCell>
        <mxCell id="xlv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;" value="&lt;b&gt;Proveedor de liveness&lt;/b&gt;&lt;br&gt;Comercial, con PAD (ISO/IEC 30107-3)" vertex="1">
          <mxGeometry height="90" width="210" x="780" y="520" as="geometry" />
        </mxCell>
        <mxCell id="xid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#042C53;" value="&lt;b&gt;Entra External ID&lt;/b&gt;&lt;br&gt;Usuarios y MFA" vertex="1">
          <mxGeometry height="90" width="210" x="1485" y="520" as="geometry" />
        </mxCell>
        <mxCell id="xkyc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;" value="&lt;b&gt;Sistema de cumplimiento&lt;/b&gt;&lt;br&gt;Listas, PEP, reportes UAFE" vertex="1"><mxGeometry x="1015" y="520" width="210" height="90" as="geometry" /></mxCell><mxCell id="xcor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;" value="&lt;b&gt;Core bancario&lt;/b&gt;&lt;br&gt;Persona, cliente y cuenta" vertex="1"><mxGeometry x="1250" y="520" width="210" height="90" as="geometry" /></mxCell><mxCell id="nt" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F5E5A;" value="&lt;b&gt;Flujo:&lt;/b&gt; el cliente acepta el tratamiento de sus datos biométricos y captura su cédula. El proveedor de liveness confirma que es una persona real y entrega un cuadro certificado; el orquestador compara ese mismo cuadro con el Registro Civil, realiza la debida diligencia (listas y PEP), crea el cliente en el Core y crea la identidad en Entra External ID, donde el cliente define su contraseña (primer factor). Al terminar, la app genera una llave en el dispositivo (Keychain o Keystore), protegida por huella o rostro, y registra su clave pública en el BFF Móvil (segundo factor). &lt;b&gt;Seguridad:&lt;/b&gt; endpoint de onboarding limitado por tasa y protegido con atestación del dispositivo, no se guardan imágenes más tiempo del necesario (protección de datos personales), y cada paso queda en auditoría. &lt;b&gt;Supuestos de diseño:&lt;/b&gt; el proveedor de liveness es una solución comercial con detección de ataques de presentación certificada, detrás de un adaptador; el Core crea la persona, el cliente y la cuenta con una clave de idempotencia igual al identificador del trámite, y el sistema de cumplimiento del banco entrega el resultado de listas restrictivas y PEP." vertex="1">
          <mxGeometry height="200" width="1700" x="40" y="680" as="geometry" />
        </mxCell>
        <mxCell id="e0" edge="1" parent="1" source="app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="ctl" value="HTTPS (sin token aún)">
