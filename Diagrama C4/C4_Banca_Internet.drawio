ntenedor: Azure SQL Database]" vertex="1"><mxGeometry x="1000" y="330" width="260" height="80" as="geometry" /></mxCell><mxCell id="job" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Proceso de precarga&lt;/b&gt;&lt;br&gt;Cada madrugada: clientes con 8 o más ingresos en 30 días" vertex="1"><mxGeometry x="620" y="480" width="240" height="90" as="geometry" /></mxCell><mxCell id="sin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;" value="&lt;b&gt;Sincronizador&lt;/b&gt;&lt;br&gt;Aplica los cambios del Core" vertex="1"><mxGeometry x="1340" y="330" width="240" height="80" as="geometry" /></mxCell><mxCell id="core" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;" value="&lt;b&gt;Core bancario&lt;/b&gt;&lt;br&gt;Eventos, API o CDC" vertex="1"><mxGeometry x="1365" y="500" width="190" height="80" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="app" target="bff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;" value="HTTPS, JWT"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="bff" target="mov" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;" value="REST"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="mov" target="red" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;" value="1. Lee (TLS)"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="mov" target="bdl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="2. Si no está: lee la base y guarda en Redis"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" edge="1" parent="1" source="job" target="bdl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" value="Lee saldos y movimientos"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" edge="1" parent="1" source="job" target="red" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" value="Precarga (cache warming)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="668" y="290" /><mxPoint x="1052" y="290" /></Array></mxGeometry></mxCell><mxCell id="e6" edge="1" parent="1" source="core" target="sin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="Cambios"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" edge="1" parent="1" source="sin" target="bdl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="Actualiza la réplica"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" edge="1" parent="1" source="sin" target="red" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="Invalida o reescribe las claves afectadas"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="195" /></Array></mxGeometry></mxCell><mxCell id="e9" edge="1" parent="1" source="bff" target="job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="Al iniciar sesión: precarga anticipada"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="aud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#042C53;" value="&lt;b&gt;Auditoría&lt;/b&gt;&lt;br&gt;[Contenedor: Azure Data Explorer]&lt;br&gt;Ingresos de los clientes" vertex="1"><mxGeometry x="620" y="650" width="240" height="80" as="geometry" /></mxCell><mxCell id="nt" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F5E5A;" value="&lt;b&gt;Reglas:&lt;/b&gt; Cache-Aside: el servicio de consulta lee Redis y, si el dato no está, lo lee de la base de lectura y lo guarda. El Sincronizador invalida o reescribe las claves de las cuentas afectadas y el proceso de precarga escribe los datos de los clientes frecuentes. Un cliente frecuente inicia sesión al menos ocho veces en los últimos treinta días, según la auditoría. Los movimientos se guardan por páginas con claves por cursor (ancladas a un movimiento o a una fecha): solo la primera se invalida con cada transacción nueva y las páginas antiguas no cambian. Las cuentas con muy alta actividad no cachean la primera página o agrupan las invalidaciones. Saldos: TTL de 5 minutos; perfil: 15 minutos. Si Redis no responde, los servicios leen la base de lectura." vertex="1"><mxGeometry x="40" y="780" width="1600" height="80" as="geometry" /></mxCell><mxCell id="e10" edge="1" parent="1" source="job" target="aud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;labelBackgroundColor=#ffffff;strokeColor=#5F5E5A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Lee los ingresos de 30 días"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="C3 Onboarding" id="pg7">
    <mxGraphModel dx="1777" dy="872" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
