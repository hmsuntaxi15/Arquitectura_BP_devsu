        <mxCell id="sb" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#042C53;" value="&lt;b&gt;Service Bus&lt;/b&gt;&lt;br&gt;transferencias.eventos / transferencias.respuestas" vertex="1">
